# TradeMachine Dashboard - environment configuration
# Copy to `.env` and adjust. Never commit `.env`.

# Base URL of the Flask WebBridge.
# NOTE: Config.mqh declares Inp_HTTP_Port = 8080, but WebBridge.py (the real
# server this dashboard talks to) listens on 5000. Use 5000.
VITE_API_BASE_URL=http://127.0.0.1:5000

# Use the in-memory mock repository instead of real HTTP.
# Four endpoints are still stubs on the backend (/api/brute/status,
# /api/trades/list, /api/metrics/session, /api/symbol/info), so mocks let the
# UI be developed and reviewed before MT5 integration lands.
# "true" | "false"
VITE_USE_MOCK_API=true

# Poll interval in ms. MT5 reads the command file once per second, so polling
# faster than 1000ms yields no fresher data.
VITE_POLL_INTERVAL_MS=1000

# Request timeout in ms.
VITE_REQUEST_TIMEOUT_MS=8000
