//+------------------------------------------------------------------+
//|                                      TradeMachine_Test.mq5       |
//|                       Self-contained protocol test EA for VOL_80 |
//|  Protocol: BRUTE -> +/-50% NORMAL -> +/-50% BRUTE -> ...         |
//|  Full CSV logging + circuit breakers. No external .mqh deps.     |
//+------------------------------------------------------------------+
#property copyright "TradeMachine"
#property link      "https://haikaldev.my.id"
#property version   "4.30"

// Single source of truth for build identity. __DATETIME__ is the COMPILE time,
// so the log proves which binary actually ran - a stale .ex5 shows an old stamp.
#define TM_VERSION "4.30"

#include <Trade\Trade.mqh>

enum RUN_MODE { MODE_NORMAL = 0, MODE_BRUTE = 1, MODE_STOPPED = 2 };
enum START_MODE { START_BRUTE = 0, START_NORMAL = 1 };

input group "=== PROTOCOL ==="
input START_MODE Inp_StartMode      = START_BRUTE;
input double Inp_SwitchThresholdPct = 50.0;
input double Inp_HardStopPct        = 95.0;
input double Inp_FastDropPct        = 20.0;
input int    Inp_FastDropWindowMin  = 10;
input int    Inp_PauseMinutes       = 30;
input double Inp_MaxRuntimeHours    = 168.0;
input bool   Inp_AllowBruteStage    = true;

input group "=== NORMAL MODE ==="
input double Inp_NormalRiskPct      = 2.0;
input double Inp_NormalTP1_RR       = 1.5;
input double Inp_NormalTP2_RR       = 3.0;
input int    Inp_DonchianBars       = 20;
input int    Inp_SwingBars          = 5;

input group "=== BRUTE MODE ==="
input double Inp_BruteRiskPct       = 1.0;
input double Inp_BruteBreathingPts  = 150.0;  // Real room from VALUATION side before SL fires
input double Inp_BruteTP_RR         = 1.5;
input double Inp_BruteLockR         = 0.6;    // must be < Inp_BruteTP_RR or the lock can never fire before TP
input double Inp_BruteMinBodyRatio  = 0.75;
input double Inp_BruteVolMult       = 0.0;
input int    Inp_BruteMaxPerMinute  = 20;
input int    Inp_BruteCooldownSec   = 3;
input int    Inp_BruteMaxConcurrent = 6;
input double Inp_BruteMarginUsePct  = 50.0;
input int    Inp_BruteMaxReentries  = 10;

input group "=== GLOBAL FILTERS ==="
input double Inp_MaxSpreadPoints    = 150.0;
input int    Inp_Magic              = 8088001;

struct TrackedPos { ulong ticket; bool in_use; bool is_brute; ENUM_POSITION_TYPE type; double volume; double entry; double val_ref; double sl; double sl_plus; double tp1_draft; double tp2_draft; double sl_dist_pts; bool slplus_set; datetime open_time; };

CTrade g_trade;
RUN_MODE g_mode = MODE_NORMAL;
double g_mode_ref_balance = 0.0, g_initial_balance = 0.0;
datetime g_start_time, g_paused_until = 0, g_last_normal_bar = 0, g_reentry_cooldown_until = 0, g_last_brute_order = 0;
int g_brute_orders_this_minute = 0, g_brute_minute = -1, g_brute_reentry_streak = 0, g_h1_ema50 = INVALID_HANDLE;
bool g_perm_warned = false;
TrackedPos g_pos[64];
string g_trades_csv = "TMTest_trades.csv", g_events_csv = "TMTest_events.csv";
struct BalSample { datetime t; double v; } g_samples[512];
int g_sample_idx = 0, g_sample_count = 0;

void CsvAppend(const string fname, const string line)
{ int h = FileOpen(fname, FILE_READ|FILE_WRITE|FILE_TXT|FILE_ANSI); if(h == INVALID_HANDLE) return; FileSeek(h, 0, SEEK_END); FileWriteString(h, line + "\r\n"); FileClose(h); }
string Now() { return TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES|TIME_SECONDS); }
void LogEvent(const string msg) { Print("[EVENT] ", msg); CsvAppend(g_events_csv, Now() + ";" + msg); }
void LogTrade(const string action, const ulong ticket, const string type, const double lots, const double price, const double sl, const double tp1, const double tp2, const double profit, const string note)
{ double spread = (double)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD); CsvAppend(g_trades_csv, Now() + ";" + action + ";" + IntegerToString((long)ticket) + ";" + type + ";" + DoubleToString(lots, 2) + ";" + DoubleToString(price, 0) + ";" + DoubleToString(sl, 0) + ";" + DoubleToString(tp1, 0) + ";" + DoubleToString(tp2, 0) + ";" + DoubleToString(profit, 2) + ";" + DoubleToString(spread, 0) + ";" + ModeName() + ";" + note); }
string ModeName() { switch(g_mode) { case MODE_NORMAL:  return "NORMAL"; case MODE_BRUTE:   return "BRUTE"; case MODE_STOPPED: return "STOPPED"; default: return "?"; } }

double SpreadPts()      { return (double)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD); }
double TickValue()      { return SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE); }
double PointSize()      { return SymbolInfoDouble(_Symbol, SYMBOL_POINT); }
int    StopsLevelPts()  { return (int)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL); }

double NormalizeLots(double lots)
{ double vmin  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN); double vmax  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX); double vstep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP); lots = MathFloor(lots / vstep) * vstep; lots = MathMax(vmin, MathMin(vmax, lots)); return NormalizeDouble(lots, 2); }

// Sanity gate for stop prices. Catches uninitialised / runaway values
// (e.g. a min/max seeded with the wrong sentinel) BEFORE they reach the server
// as [invalid stops]. Returns false and logs loudly on anything implausible.
bool ValidStop(const double price, const double sl, const bool is_buy)
{ if(!MathIsValidNumber(sl) || !MathIsValidNumber(price)) { LogEvent("STOP REJECT: non-finite value (price=" + DoubleToString(price,1) + " sl=" + DoubleToString(sl,1) + ")"); return false; } if(sl <= 0.0) { LogEvent("STOP REJECT: sl <= 0"); return false; } double dist = MathAbs(price - sl); double max_dist = price * 0.5; if(dist > max_dist) { LogEvent("STOP REJECT: distance " + DoubleToString(dist,1) + " exceeds 50% of price (sl=" + DoubleToString(sl,1) + ")"); return false; } if(is_buy && sl >= price) { LogEvent("STOP REJECT: buy sl above entry"); return false; } if(!is_buy && sl <= price) { LogEvent("STOP REJECT: sell sl below entry"); return false; } return true; }

double LotsFromRisk(const double dist_pts, const double risk_pct)
{ double balance = AccountInfoDouble(ACCOUNT_BALANCE); double risk_amt = balance * risk_pct / 100.0; double tv = TickValue(); if(tv <= 0 || dist_pts <= 0) return 0.0; return NormalizeLots(risk_amt / (dist_pts * tv)); }

bool NewBar(const ENUM_TIMEFRAMES tf, datetime &last_time)
{ datetime t = iTime(_Symbol, tf, 0); if(t != last_time) { last_time = t; return true; } return false; }

int FindSlot(const ulong ticket) { for(int i = 0; i < ArraySize(g_pos); i++) if(g_pos[i].in_use && g_pos[i].ticket == ticket) return i; return -1; }
int FreeSlot() { for(int i = 0; i < ArraySize(g_pos); i++) if(!g_pos[i].in_use) return i; return -1; }

int CountPositions(const bool brute_only)
{ int c = 0; for(int i = PositionsTotal() - 1; i >= 0; i--) { ulong t = PositionGetTicket(i); if(!PositionSelectByTicket(t)) continue; if(PositionGetInteger(POSITION_MAGIC) != Inp_Magic) continue; int s = FindSlot(t); if(s < 0) continue; if(brute_only && !g_pos[s].is_brute) continue; c++; } return c; }

void TrackOpen(const ulong ticket, const bool is_brute, const ENUM_POSITION_TYPE type, const double volume, const double entry, const double val_ref, const double sl, const double tp1, const double tp2, const double sl_dist_pts)
{ int s = FreeSlot(); if(s < 0) return; g_pos[s].ticket       = ticket; g_pos[s].in_use       = true; g_pos[s].is_brute     = is_brute; g_pos[s].type         = type; g_pos[s].volume       = volume; g_pos[s].entry        = entry; g_pos[s].val_ref      = val_ref; g_pos[s].sl           = sl; g_pos[s].sl_plus      = 0.0; g_pos[s].tp1_draft    = tp1; g_pos[s].tp2_draft    = tp2; g_pos[s].sl_dist_pts  = sl_dist_pts; g_pos[s].slplus_set   = false; g_pos[s].open_time    = TimeCurrent(); }

ulong ResolvePositionTicket(const ulong order_ticket, double &volume_out)
{ volume_out = 0.0; if(PositionSelectByTicket(order_ticket)) { if(PositionGetInteger(POSITION_MAGIC) == Inp_Magic) { volume_out = PositionGetDouble(POSITION_VOLUME); return order_ticket; } } if(HistorySelect(TimeCurrent() - 300, TimeCurrent() + 60)) { int n = HistoryDealsTotal(); for(int i = n - 1; i >= 0; i--) { ulong d = HistoryDealGetTicket(i); if(d == 0) continue; if((ulong)HistoryDealGetInteger(d, DEAL_ORDER) != order_ticket) continue; ulong pid = (ulong)HistoryDealGetInteger(d, DEAL_POSITION_ID); if(pid != 0 && PositionSelectByTicket(pid)) { volume_out = PositionGetDouble(POSITION_VOLUME); return pid; } } } return 0; }

int H1Trend() { if(g_h1_ema50 == INVALID_HANDLE) return 0; double buf[1]; if(CopyBuffer(g_h1_ema50, 0, 1, 1, buf) < 1) return 0; double close1 = iClose(_Symbol, PERIOD_H1, 1); if(close1 > buf[0]) return 1; if(close1 < buf[0]) return -1; return 0; }

void ReportSignalRate()
{ MqlRates r[]; ArraySetAsSeries(r, true); int want = 3000; int got = CopyRates(_Symbol, PERIOD_M1, 0, want, r); if(got < 200) { LogEvent("SIGNAL PROBE: insufficient M1 history (" + IntegerToString(got) + " bars)"); return; } int hits_body = 0, hits_both = 0, checked = 0; for(int i = 1; i < got - 21; i++) { double rng = r[i].high - r[i].low; if(rng <= 0) continue; double ratio = MathAbs(r[i].close - r[i].open) / rng; bool body_ok = (ratio >= Inp_BruteMinBodyRatio); long vsum = 0; for(int k = i + 1; k <= i + 20; k++) vsum += r[k].tick_volume; double avg = (double)vsum / 20.0; bool vol_ok = (Inp_BruteVolMult <= 0.0) || (avg > 0 && (double)r[i].tick_volume >= avg * Inp_BruteVolMult); checked++; if(body_ok) hits_body++; if(body_ok && vol_ok) hits_both++; } if(checked <= 0) return; double pct_body = (double)hits_body / checked * 100.0; double pct_both = (double)hits_both / checked * 100.0; double per_min  = (double)hits_both / checked; LogEvent("SIGNAL PROBE over " + IntegerToString(checked) + " M1 bars: body>=" + DoubleToString(Inp_BruteMinBodyRatio, 2) + " -> " + DoubleToString(pct_body, 2) + "% | +volFilter(" + DoubleToString(Inp_BruteVolMult, 2) + ") -> " + DoubleToString(pct_both, 2) + "%"); LogEvent("SIGNAL PROBE estimate: ~" + DoubleToString(per_min, 2) + " signals/min, ~" + DoubleToString(per_min * 60.0, 1) + "/hour"); if(hits_both == 0) Print("WARNING: zero momentum signals in probe window. EA will not trade. Loosen filters."); else if(per_min * 60.0 < 1.0) Print("WARNING: signal rate below 1/hour. Expect very few entries."); }

void NormalEntry()
{ if(CountPositions(false) > 0) return; datetime bar_time = iTime(_Symbol, PERIOD_M5, 0); if(bar_time == g_last_normal_bar) return; MqlRates r[]; ArraySetAsSeries(r, true); int need = Inp_DonchianBars + Inp_SwingBars + 5; if(CopyRates(_Symbol, PERIOD_M5, 0, need, r) < need) return; g_last_normal_bar = bar_time; int trend = H1Trend(); if(trend == 0) return; double hi = -DBL_MAX, lo = DBL_MAX; for(int i = 2; i <= Inp_DonchianBars + 1; i++) { if(r[i].high > hi) hi = r[i].high; if(r[i].low  < lo) lo = r[i].low; } double close1 = r[1].close; double spread = SpreadPts(); if(trend > 0 && close1 > hi) { double entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK); double swing_low = DBL_MAX; for(int i = 1; i <= Inp_SwingBars; i++) if(r[i].low < swing_low) swing_low = r[i].low; double sl = swing_low - 3.0 * PointSize(); double dist_pts = (entry - sl) / PointSize(); double min_dist = spread + 5.0; if(dist_pts < min_dist) { LogEvent("NORMAL BUY rejected: SL dist " + DoubleToString(dist_pts,1) + " < min " + DoubleToString(min_dist,1)); return; } double lots = LotsFromRisk(dist_pts, Inp_NormalRiskPct); if(lots <= 0) return; double tp1 = entry + dist_pts * Inp_NormalTP1_RR * PointSize(); double tp2 = entry + dist_pts * Inp_NormalTP2_RR * PointSize(); if(!ValidStop(entry, NormalizeDouble(sl, 0), true)) return; if(!g_trade.Buy(lots, _Symbol, entry, NormalizeDouble(sl, 0), 0.0, "TM_N")) { LogEvent("NORMAL BUY send failed: " + IntegerToString((int)g_trade.ResultRetcode())); return; } double vol_actual = 0.0; ulong ticket = ResolvePositionTicket(g_trade.ResultOrder(), vol_actual); if(ticket == 0) { LogEvent("NORMAL BUY: position ticket unresolved"); return; } TrackOpen(ticket, false, POSITION_TYPE_BUY, vol_actual, entry, SymbolInfoDouble(_Symbol, SYMBOL_BID), sl, tp1, tp2, dist_pts); LogTrade("OPEN", ticket, "BUY", vol_actual, entry, sl, tp1, tp2, 0.0, "donchian_breakout"); LogEvent("NORMAL BUY " + DoubleToString(vol_actual,2) + " lots @ " + DoubleToString(entry,0) + " SL=" + DoubleToString(sl,0) + " TP1=" + DoubleToString(tp1,0) + " TP2=" + DoubleToString(tp2,0)); } else if(trend < 0 && close1 < lo) { double entry = SymbolInfoDouble(_Symbol, SYMBOL_BID); double swing_high = -DBL_MAX; for(int i = 1; i <= Inp_SwingBars; i++) if(r[i].high > swing_high) swing_high = r[i].high; double sl = swing_high + 3.0 * PointSize(); double dist_pts = (sl - entry) / PointSize(); double min_dist = spread + 5.0; if(dist_pts < min_dist) { LogEvent("NORMAL SELL rejected: SL dist " + DoubleToString(dist_pts,1) + " < min " + DoubleToString(min_dist,1)); return; } double lots = LotsFromRisk(dist_pts, Inp_NormalRiskPct); if(lots <= 0) return; double tp1 = entry - dist_pts * Inp_NormalTP1_RR * PointSize(); double tp2 = entry - dist_pts * Inp_NormalTP2_RR * PointSize(); if(!ValidStop(entry, NormalizeDouble(sl, 0), false)) return; if(!g_trade.Sell(lots, _Symbol, entry, NormalizeDouble(sl, 0), 0.0, "TM_N")) { LogEvent("NORMAL SELL send failed: " + IntegerToString((int)g_trade.ResultRetcode())); return; } double vol_actual = 0.0; ulong ticket = ResolvePositionTicket(g_trade.ResultOrder(), vol_actual); if(ticket == 0) { LogEvent("NORMAL SELL: position ticket unresolved"); return; } TrackOpen(ticket, false, POSITION_TYPE_SELL, vol_actual, entry, SymbolInfoDouble(_Symbol, SYMBOL_ASK), sl, tp1, tp2, dist_pts); LogTrade("OPEN", ticket, "SELL", vol_actual, entry, sl, tp1, tp2, 0.0, "donchian_breakout"); LogEvent("NORMAL SELL " + DoubleToString(vol_actual,2) + " lots @ " + DoubleToString(entry,0) + " SL=" + DoubleToString(sl,0) + " TP1=" + DoubleToString(tp1,0) + " TP2=" + DoubleToString(tp2,0)); } }

int BruteMomentum() { MqlRates r[]; ArraySetAsSeries(r, true); if(CopyRates(_Symbol, PERIOD_M1, 0, 25, r) < 25) return 0; double body  = MathAbs(r[1].close - r[1].open); double range = r[1].high - r[1].low; if(range <= 0) return 0; if(body / range < Inp_BruteMinBodyRatio) return 0; long vol_sum = 0; for(int i = 2; i <= 21; i++) vol_sum += r[i].tick_volume; double avg_vol = (double)vol_sum / 20.0; if(avg_vol <= 0 || (double)r[1].tick_volume < avg_vol * Inp_BruteVolMult) return 0; return (r[1].close > r[1].open) ? 1 : -1; }

void BruteEntry()
{ if(TimeCurrent() < g_paused_until) return; if(TimeCurrent() < g_reentry_cooldown_until) return; if(CountPositions(true) >= Inp_BruteMaxConcurrent) return; if(FreeSlot() < 0) { static datetime last_slot_warn = 0; if(TimeCurrent() - last_slot_warn > 60) { last_slot_warn = TimeCurrent(); LogEvent("BRUTE skipped: tracking slots full (" + IntegerToString(ArraySize(g_pos)) + ")"); } return; } int minute_now = (int)(TimeCurrent() / 60); if(minute_now != g_brute_minute) { g_brute_minute = minute_now; g_brute_orders_this_minute = 0; } if(g_brute_orders_this_minute >= Inp_BruteMaxPerMinute) return; if(TimeCurrent() - g_last_brute_order < Inp_BruteCooldownSec) return; int dir = BruteMomentum(); if(dir == 0) return; double spread = SpreadPts(); double pt = PointSize(); double sl_dist_pts = Inp_BruteBreathingPts + spread; if(sl_dist_pts < StopsLevelPts() + spread + 1.0) sl_dist_pts = StopsLevelPts() + spread + 1.0; double lots = LotsFromRisk(sl_dist_pts, Inp_BruteRiskPct); if(lots <= 0) return; double need_margin = 0.0; ENUM_ORDER_TYPE probe = (dir > 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL; double probe_price = (dir > 0) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID); if(OrderCalcMargin(probe, _Symbol, lots, probe_price, need_margin)) { double free_margin = AccountInfoDouble(ACCOUNT_MARGIN_FREE); double cap = free_margin * Inp_BruteMarginUsePct / 100.0; if(need_margin > cap) { static datetime last_margin_warn = 0; if(TimeCurrent() - last_margin_warn > 60) { last_margin_warn = TimeCurrent(); LogEvent("BRUTE skipped: margin " + DoubleToString(need_margin, 2) + " > cap " + DoubleToString(cap, 2) + " (free " + DoubleToString(free_margin, 2) + ")"); } return; } } if(dir > 0) { double entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK); double sl    = NormalizeDouble(entry - sl_dist_pts * pt, 0); double bid_now = SymbolInfoDouble(_Symbol, SYMBOL_BID); double tp1   = bid_now + Inp_BruteTP_RR * Inp_BruteBreathingPts * pt; double lock_bid = bid_now + Inp_BruteLockR * Inp_BruteBreathingPts * pt; double slplus_plan = (entry + lock_bid) / 2.0; if(!ValidStop(entry, sl, true)) return; if(!g_trade.Buy(lots, _Symbol, entry, sl, 0.0, "TM_B")) { LogEvent("BRUTE BUY send failed: " + IntegerToString((int)g_trade.ResultRetcode())); return; } double vol_actual = 0.0; ulong ticket = ResolvePositionTicket(g_trade.ResultOrder(), vol_actual); if(ticket == 0) { LogEvent("BRUTE BUY: position ticket unresolved"); return; } TrackOpen(ticket, true, POSITION_TYPE_BUY, vol_actual, entry, bid_now, sl, tp1, 0.0, sl_dist_pts); LogTrade("OPEN", ticket, "BUY", vol_actual, entry, sl, tp1, 0.0, 0.0, "brute_momentum"); g_brute_orders_this_minute++; g_last_brute_order = TimeCurrent(); } else { double entry = SymbolInfoDouble(_Symbol, SYMBOL_BID); double sl    = NormalizeDouble(entry + sl_dist_pts * pt, 0); double ask_now = SymbolInfoDouble(_Symbol, SYMBOL_ASK); double tp1   = ask_now - Inp_BruteTP_RR * Inp_BruteBreathingPts * pt; if(!ValidStop(entry, sl, false)) return; if(!g_trade.Sell(lots, _Symbol, entry, sl, 0.0, "TM_B")) { LogEvent("BRUTE SELL send failed: " + IntegerToString((int)g_trade.ResultRetcode())); return; } double vol_actual = 0.0; ulong ticket = ResolvePositionTicket(g_trade.ResultOrder(), vol_actual); if(ticket == 0) { LogEvent("BRUTE SELL: position ticket unresolved"); return; } TrackOpen(ticket, true, POSITION_TYPE_SELL, vol_actual, entry, ask_now, sl, tp1, 0.0, sl_dist_pts); LogTrade("OPEN", ticket, "SELL", vol_actual, entry, sl, tp1, 0.0, 0.0, "brute_momentum"); g_brute_orders_this_minute++; g_last_brute_order = TimeCurrent(); } }

bool GetCloseDeal(const ulong ticket, const datetime open_time, double &close_price, double &profit, string &reason)
{ if(!HistorySelect(open_time - 120, TimeCurrent() + 120)) return false; int n = HistoryDealsTotal(); for(int i = 0; i < n; i++) { ulong d = HistoryDealGetTicket(i); if(d == 0) continue; if((ulong)HistoryDealGetInteger(d, DEAL_POSITION_ID) != ticket) continue; if(HistoryDealGetInteger(d, DEAL_ENTRY) != DEAL_ENTRY_OUT) continue; close_price = HistoryDealGetDouble(d, DEAL_PRICE); profit      = HistoryDealGetDouble(d, DEAL_PROFIT) + HistoryDealGetDouble(d, DEAL_SWAP) + HistoryDealGetDouble(d, DEAL_COMMISSION); long r = HistoryDealGetInteger(d, DEAL_REASON); reason = (r == DEAL_REASON_SL) ? "SL" : (r == DEAL_REASON_TP) ? "TP" : (r == DEAL_REASON_CLIENT) ? "MANUAL" : "OTHER"; return true; } return false; }

void ManagePositions()
{ double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID); double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK); for(int i = 0; i < ArraySize(g_pos); i++) { if(!g_pos[i].in_use) continue; ulong ticket = g_pos[i].ticket; if(!PositionSelectByTicket(ticket)) { double cp = 0, pf = 0; string reason = "GONE"; GetCloseDeal(ticket, g_pos[i].open_time, cp, pf, reason); bool was_brute = g_pos[i].is_brute; LogTrade("CLOSE", ticket, (g_pos[i].type == POSITION_TYPE_BUY) ? "BUY" : "SELL", g_pos[i].volume, cp, g_pos[i].sl, g_pos[i].tp1_draft, g_pos[i].tp2_draft, pf, reason); if(was_brute) { bool sl_hit = (reason == "SL"); if(!sl_hit) { if(g_pos[i].type == POSITION_TYPE_BUY && cp <= g_pos[i].sl + 3.0) sl_hit = true; if(g_pos[i].type == POSITION_TYPE_SELL && cp >= g_pos[i].sl - 3.0) sl_hit = true; } if(sl_hit) { g_brute_reentry_streak++; if(g_brute_reentry_streak >= Inp_BruteMaxReentries) { g_reentry_cooldown_until = TimeCurrent() + 60; LogEvent("BRUTE re-entry streak cap reached (" + IntegerToString(g_brute_reentry_streak) + "), cooldown 60s"); g_brute_reentry_streak = 0; } } else g_brute_reentry_streak = 0; } else g_brute_reentry_streak = 0; g_pos[i].in_use = false; continue; } if(g_pos[i].is_brute) { if(!g_pos[i].slplus_set) { double lock_move = Inp_BruteLockR * Inp_BruteBreathingPts * PointSize(); double lock_price = (g_pos[i].type == POSITION_TYPE_BUY) ? g_pos[i].val_ref + lock_move : g_pos[i].val_ref - lock_move; bool reached = (g_pos[i].type == POSITION_TYPE_BUY) ? (bid >= lock_price) : (ask <= lock_price); if(reached) { double slplus = (g_pos[i].type == POSITION_TYPE_BUY) ? (g_pos[i].entry + lock_price) / 2.0 : (g_pos[i].entry + lock_price) / 2.0; if(g_trade.PositionModify(ticket, NormalizeDouble(slplus, 0), 0.0)) { g_pos[i].sl_plus = slplus; g_pos[i].slplus_set = true; LogEvent("BRUTE SL+ LOCKED ticket " + IntegerToString((long)ticket) + " @ " + DoubleToString(slplus, 0)); } } } if(g_pos[i].tp1_draft > 0) { bool tp_hit = (g_pos[i].type == POSITION_TYPE_BUY) ? (bid >= g_pos[i].tp1_draft) : (ask <= g_pos[i].tp1_draft); if(tp_hit) { if(g_trade.PositionClose(ticket)) LogEvent("BRUTE TP hit, closed ticket " + IntegerToString((long)ticket)); } } } else { if(!g_pos[i].slplus_set && g_pos[i].tp1_draft > 0) { bool tp1_hit = (g_pos[i].type == POSITION_TYPE_BUY) ? (bid >= g_pos[i].tp1_draft) : (ask <= g_pos[i].tp1_draft); if(tp1_hit) { double slplus = (g_pos[i].entry + g_pos[i].tp1_draft) / 2.0; if(g_trade.PositionModify(ticket, NormalizeDouble(slplus, 0), 0.0)) { g_pos[i].sl_plus = slplus; g_pos[i].slplus_set = true; LogEvent("NORMAL SL+ set ticket " + IntegerToString((long)ticket) + " @ " + DoubleToString(slplus, 0)); } } } if(g_pos[i].slplus_set && g_pos[i].tp2_draft > 0) { bool tp2_hit = (g_pos[i].type == POSITION_TYPE_BUY) ? (bid >= g_pos[i].tp2_draft) : (ask <= g_pos[i].tp2_draft); if(tp2_hit) { if(g_trade.PositionClose(ticket)) LogEvent("NORMAL TP2 hit, closed ticket " + IntegerToString((long)ticket)); } } } } }

void CloseAll(const string why) { for(int i = PositionsTotal() - 1; i >= 0; i--) { ulong t = PositionGetTicket(i); if(!PositionSelectByTicket(t)) continue; if(PositionGetInteger(POSITION_MAGIC) != Inp_Magic) continue; g_trade.PositionClose(t); } LogEvent("CLOSE ALL: " + why); }

void SwitchMode(const double balance) { CloseAll("mode switch"); RUN_MODE next = (g_mode == MODE_NORMAL) ? MODE_BRUTE : MODE_NORMAL; if(next == MODE_BRUTE && !Inp_AllowBruteStage) { g_mode = MODE_STOPPED; LogEvent("Brute stage disabled by input -> STOPPED. Final balance: " + DoubleToString(balance, 2)); return; } g_mode = next; g_mode_ref_balance = balance; g_brute_reentry_streak = 0; g_brute_orders_this_minute = 0; LogEvent("MODE SWITCH -> " + ModeName() + " at balance " + DoubleToString(balance, 2)); }

void RecordSample() { g_samples[g_sample_idx].t = TimeCurrent(); g_samples[g_sample_idx].v = AccountInfoDouble(ACCOUNT_BALANCE); g_sample_idx = (g_sample_idx + 1) % 512; if(g_sample_count < 512) g_sample_count++; }

bool FastDropDetected(const double current_balance) { datetime cutoff = TimeCurrent() - Inp_FastDropWindowMin * 60; for(int i = 0; i < g_sample_count; i++) { if(g_samples[i].t < cutoff) continue; if(g_samples[i].v <= 0) continue; double drop_pct = (g_samples[i].v - current_balance) / g_samples[i].v * 100.0; if(drop_pct >= Inp_FastDropPct) return true; } return false; }

void RunProtocol() { if(g_mode == MODE_STOPPED) return; double balance = AccountInfoDouble(ACCOUNT_BALANCE); if(balance <= g_initial_balance * (1.0 - Inp_HardStopPct / 100.0)) { g_mode = MODE_STOPPED; CloseAll("hard stop: lost " + DoubleToString(Inp_HardStopPct, 0) + "% of initial"); LogEvent("HARD STOP. Final balance: " + DoubleToString(balance, 2)); return; } if(TimeCurrent() - g_start_time > (int)(Inp_MaxRuntimeHours * 3600)) { g_mode = MODE_STOPPED; CloseAll("runtime cap reached"); LogEvent("RUNTIME CAP. Final balance: " + DoubleToString(balance, 2)); return; } if(FastDropDetected(balance) && TimeCurrent() >= g_paused_until) { g_paused_until = TimeCurrent() + Inp_PauseMinutes * 60; LogEvent("FAST DROP pause until " + TimeToString(g_paused_until, TIME_MINUTES)); } double up = g_mode_ref_balance * (1.0 + Inp_SwitchThresholdPct / 100.0); double dn = g_mode_ref_balance * (1.0 - Inp_SwitchThresholdPct / 100.0); if(balance >= up || balance <= dn) SwitchMode(balance); }

void UpdateComment() { double balance = AccountInfoDouble(ACCOUNT_BALANCE); double equity  = AccountInfoDouble(ACCOUNT_EQUITY); double chg_from_mode = (g_mode_ref_balance > 0) ? (balance - g_mode_ref_balance) / g_mode_ref_balance * 100.0 : 0.0; double chg_from_start = (g_initial_balance > 0) ? (balance - g_initial_balance) / g_initial_balance * 100.0 : 0.0; string paused = (TimeCurrent() < g_paused_until) ? "  [PAUSED]" : ""; Comment("TradeMachine TEST  |  MODE: ", ModeName(), paused, "\nBalance: ", DoubleToString(balance, 2), "  Equity: ", DoubleToString(equity, 2), "\nSince mode start: ", DoubleToString(chg_from_mode, 2), "%   Since start: ", DoubleToString(chg_from_start, 2), "%", "\nPositions: N=", CountPositions(false) - CountPositions(true), " B=", CountPositions(true), "  Spread: ", DoubleToString(SpreadPts(), 0), "\nBrute orders this minute: ", g_brute_orders_this_minute, "  Re-entry streak: ", g_brute_reentry_streak); }

int OnInit() { Print("========================================"); Print("TradeMachine TEST EA v", TM_VERSION, " - protocol runner"); Print("build compiled: ", __DATETIME__); Print("========================================"); if(!MQLInfoInteger(MQL_TRADE_ALLOWED) || !TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)) { Print("--- trade permission check ---"); Print("  TERMINAL_TRADE_ALLOWED (AutoTrading button) : ", TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) ? "ON" : "OFF"); Print("  MQL_TRADE_ALLOWED (EA 'Allow Algo Trading') : ", MQLInfoInteger(MQL_TRADE_ALLOWED) ? "ON" : "OFF"); Print("  ACCOUNT_TRADE_ALLOWED (server side)         : ", AccountInfoInteger(ACCOUNT_TRADE_ALLOWED) ? "ON" : "OFF"); Print("  ACCOUNT_TRADE_EXPERT  (server side)         : ", AccountInfoInteger(ACCOUNT_TRADE_EXPERT) ? "ON" : "OFF"); if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)) Print(">> FIX: click the 'Algo Trading' / 'AutoTrading' button in the toolbar (must be green)."); if(!MQLInfoInteger(MQL_TRADE_ALLOWED)) Print(">> FIX: EA properties (F7) -> Common tab -> tick 'Allow Algo Trading' -> OK."); if(!AccountInfoInteger(ACCOUNT_TRADE_ALLOWED) || !AccountInfoInteger(ACCOUNT_TRADE_EXPERT)) Print(">> Server-side restriction. Contact broker / check account type."); return INIT_FAILED; } g_trade.SetExpertMagicNumber(Inp_Magic); long fm = SymbolInfoInteger(_Symbol, SYMBOL_FILLING_MODE); if((fm & SYMBOL_FILLING_FOK) == SYMBOL_FILLING_FOK) g_trade.SetTypeFilling(ORDER_FILLING_FOK); else if((fm & SYMBOL_FILLING_IOC) == SYMBOL_FILLING_IOC) g_trade.SetTypeFilling(ORDER_FILLING_IOC); else g_trade.SetTypeFilling(ORDER_FILLING_RETURN); g_trade.SetDeviationInPoints(50); for(int i = 0; i < ArraySize(g_pos); i++) { g_pos[i].in_use = false; g_pos[i].ticket = 0; g_pos[i].volume = 0.0; } g_h1_ema50 = iMA(_Symbol, PERIOD_H1, 50, 0, MODE_EMA, PRICE_CLOSE); if(g_h1_ema50 == INVALID_HANDLE) { Print("ERROR: cannot create H1 EMA50 handle"); return INIT_FAILED; } g_initial_balance  = AccountInfoDouble(ACCOUNT_BALANCE); g_mode_ref_balance = g_initial_balance; if(Inp_StartMode == START_BRUTE) { if(Inp_AllowBruteStage) g_mode = MODE_BRUTE; else { g_mode = MODE_NORMAL; Print("WARNING: StartMode=BRUTE but AllowBruteStage=false -> starting NORMAL."); } } else g_mode = MODE_NORMAL; g_start_time       = TimeCurrent(); g_paused_until     = 0; g_brute_reentry_streak = 0; int ts = 0; if(!FileIsExist(g_trades_csv)) { int h = FileOpen(g_trades_csv, FILE_WRITE|FILE_TXT|FILE_ANSI); if(h != INVALID_HANDLE) { FileWriteString(h, "time;action;ticket;type;lots;price;sl;tp1;tp2;profit;spread;mode;note\r\n"); FileClose(h); } } if(!FileIsExist(g_events_csv)) { int h = FileOpen(g_events_csv, FILE_WRITE|FILE_TXT|FILE_ANSI); if(h != INVALID_HANDLE) { FileWriteString(h, "time;event\r\n"); FileClose(h); } }    ReportSignalRate();
   LogEvent("BUILD v" + TM_VERSION + " compiled " + TimeToString(__DATETIME__, TIME_DATE|TIME_MINUTES));
   LogEvent("START MODE = " + ModeName() + "  (protocol: " + ModeName() + " -> +/-" + DoubleToString(Inp_SwitchThresholdPct, 0) + "% -> other mode -> ...)"); LogEvent("Config: switch=" + DoubleToString(Inp_SwitchThresholdPct, 0) + "% hardstop=" + DoubleToString(Inp_HardStopPct, 0) + "% normal_risk=" + DoubleToString(Inp_NormalRiskPct, 1) + "% brute_risk=" + DoubleToString(Inp_BruteRiskPct, 1) + "% brute_stage=" + (Inp_AllowBruteStage ? "ON" : "OFF")); LogEvent("INIT balance=" + DoubleToString(g_initial_balance, 2) + " symbol=" + _Symbol + " spread=" + DoubleToString(SpreadPts(), 0) + " stops_level=" + IntegerToString(StopsLevelPts()) + " point=" + DoubleToString(PointSize(), 2) + " tick_value=" + DoubleToString(TickValue(), 2)); return INIT_SUCCEEDED; }

void OnDeinit(const int reason) { if(g_h1_ema50 != INVALID_HANDLE) IndicatorRelease(g_h1_ema50); Comment(""); LogEvent("DEINIT reason=" + IntegerToString(reason) + " balance=" + DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE), 2)); }

void OnTick() { RecordSample(); bool can_trade = (bool)TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) && (bool)MQLInfoInteger(MQL_TRADE_ALLOWED) && (bool)AccountInfoInteger(ACCOUNT_TRADE_ALLOWED) && (bool)AccountInfoInteger(ACCOUNT_TRADE_EXPERT); if(!can_trade) { if(!g_perm_warned) { g_perm_warned = true; LogEvent("IDLE: trading disabled (AutoTrading and/or Allow Algo Trading is OFF)"); } Comment("TradeMachine TEST  |  *** IDLE - TRADING DISABLED ***", "\nAutoTrading button : ", TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) ? "ON" : "OFF", "\nAllow Algo Trading : ", MQLInfoInteger(MQL_TRADE_ALLOWED) ? "ON" : "OFF", "\nBalance: ", DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE), 2), "\n\nEA is attached and will start automatically once enabled."); return; } if(g_perm_warned) { g_perm_warned = false; LogEvent("RESUMED: trading permissions now OK"); } RunProtocol(); if(g_mode == MODE_STOPPED) { UpdateComment(); return; } if(SpreadPts() <= Inp_MaxSpreadPoints) { if(g_mode == MODE_NORMAL) NormalEntry(); else if(g_mode == MODE_BRUTE) BruteEntry(); } ManagePositions(); UpdateComment(); }